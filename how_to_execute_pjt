비전 pick and place 켜는 방법

터미널1
ros2 launch dobot_bringup dobot_magician_control_system.launch.py

터미널2
ros2 launch realsense2_camera rs_launch.py   align_depth.enable:=true   pointcloud.enable:=false

터미널3
ros2 service call /dobot_homing_service dobot_msgs/srv/ExecuteHomingProcedure

ros2 run dobot_controller two_object_pick_place --ros-args   -p target_colors:=car_lower,car_upper   -p quality_result:=normal   -p conveyor_sort_steps:=3200

//두번만 동작코드//
ros2 run dobot_controller two_object_pick_place --ros-args \
  -p target_colors:=car_lower,car_upper \
  -p conveyor_sort_steps:=16000 \
  -p max_cycles:=2

터미널4
ros2 run vision_detector realsense_object_detector --ros-args   -p detector_mode:=yolo   -p yolo_model_path:=/home/ssafy/smart-assembly-transport/models/yolo/car_parts_best.pt   -p target_labels:=car_lower,car_upper   -p min_confidence:=0.35   -p min_area:=1000.0






